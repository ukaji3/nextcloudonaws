{
  "app": "npx ts-node --prefer-ts-exts bin/cdk.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["node_modules", "cdk.out", "**/*.js", "**/*.d.ts"]
  },
  "context": {
    "domain": "cloud.example.com",
    "certificateArn": "",
    "aioImageTag": "20260929_105435",
    "nextcloudImageUri": "",
    "apachePort": 11000,
    "enableOnlyOffice": "true",
    "enableTalk": "false",
    "enableFulltextsearch": "false",
    "enableImaginary": "false",
    "enableClamav": "false",
    "auroraMinAcu": 0.5,
    "auroraMaxAcu": 16,
    "alarmEmails": "",
    "auroraBackupRetentionDays": 7,
    "backupDailyRetentionDays": 35,
    "backupWeeklyRetentionDays": 90,
    "ecrScanRepositories": "aio-nextcloud",
    "githubOwner": "ukaji3",
    "githubRepo": "nextcloudonaws",
    "githubBranch": "main"
  }
}
